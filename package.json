{
  "name": "@skyrocket-software/playwright-evidence",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "exports": {
    ".": "./dist/index.js",
    "./reporter": "./dist/reporter.js"
  },
  "bin": {
    "playwright-evidence-generate": "./dist/generate-cli.js"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsup && playwright test",
    "lint": "eslint src/ e2e/ playwright.config.ts"
  },
  "files": [
    "dist",
    "docs/TEST_WRITING_BEST_PRACTICES.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0",
    "playwright-core": ">=1.50.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "semantic-release": "^25.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "lodash-es": "^4.18.1",
    "marked": "^18.0.7",
    "pdfjs-dist": "^6.1.200"
  }
}
